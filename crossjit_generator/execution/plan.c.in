/* Generated by crossjit-generator: extension-neutral execution synthesis. */
#ifndef CROSSJIT_GENERATED_EXECUTION_H
#define CROSSJIT_GENERATED_EXECUTION_H
#include <stddef.h>
#include <stdint.h>
#include <string.h>
#define CJ_EXECUTION_ABI_VERSION 1
#define CJ_MAX_NODES @NODES@
#define CJ_MAX_INPUTS @INPUTS@
#define CJ_MAX_SLOTS (CJ_MAX_INPUTS + CJ_MAX_NODES)
#define CJ_MAX_RANK @RANK@
#define CJ_NONE UINT8_MAX

typedef enum {
@OPCODES@
} CjPrimitiveOpcode;
typedef struct { uint8_t op, left, right, output; } CjKernelNode;
typedef enum { CJ_GENERATED_STAGE, CJ_BACKEND_STAGE } CjStageKind;
typedef enum { CJ_INPUT_VALUE, CJ_TEMPORARY_VALUE, CJ_OUTPUT_VALUE } CjValueKind;
typedef enum { CJ_EXEC_ERROR=-1, CJ_EXEC_MISS=0, CJ_EXEC_OK=1 } CjExecStatus;

/* Opaque capability binding: only Provider knows its algorithm, objects,
 * layout legality, effects and status mapping. overlap_inputs authorizes
 * private input/output overlap by numerical input role, never by object type.
 * Calls preserve description order, including effects and failure barriers. */
typedef struct {
    uint16_t binding;
    uint8_t input_count;
    uint16_t overlap_inputs;
} CjBackendCapability;
typedef struct {
    uint8_t kind;
    uint16_t capability;
    uint8_t input_count, inputs[CJ_MAX_INPUTS], output;
    uint32_t after; /* explicit sequencing/effect dependencies by stage id */
    uint32_t reuse_candidates; /* validated compatible private storage only */
} CjStageDescriptor;
typedef struct {
    uint8_t kind;
    uint16_t storage_class; /* opaque compatibility class, validated by adapter */
} CjValueDescriptor;
typedef struct {
    uint8_t input_count, value_count, stage_count, output_value;
    CjValueDescriptor values[CJ_MAX_SLOTS];
    CjStageDescriptor stages[CJ_MAX_NODES];
    CjBackendCapability capabilities[CJ_MAX_NODES];
    uint8_t capability_count;
} CjExecutionDescription;
typedef struct {
    uint8_t stage_count, output_value;
    CjStageDescriptor stages[CJ_MAX_NODES];
    CjBackendCapability capabilities[CJ_MAX_NODES];
    uint8_t order[CJ_MAX_NODES];
    uint8_t producer[CJ_MAX_SLOTS], last_use[CJ_MAX_SLOTS];
    uint8_t storage_slot[CJ_MAX_SLOTS], reuse_source[CJ_MAX_SLOTS];
    uint8_t output_storage[CJ_MAX_SLOTS];
    uint32_t release_mask[CJ_MAX_NODES];
} CjExecutionPlan;

/* Runtime prepare-time synthesis over a bounded validated execution DAG.
 * Structural checks protect memory; they do not re-prove domain legality.
 * Stable dependency ordering keeps every existing backend/FPE barrier in order.
 * Plans own no allocations, function pointers, Python/extension objects or
 * cross-invocation mutable state. Runtime bridges own those separately. */
static inline int
cj_synthesize_plan(const CjExecutionDescription *d, CjExecutionPlan *p)
{
    if (!d || !p || !d->input_count || d->input_count>CJ_MAX_INPUTS ||
        !d->stage_count || d->stage_count>CJ_MAX_NODES ||
        d->value_count>CJ_MAX_SLOTS || d->value_count<d->input_count ||
        d->output_value>=d->value_count || d->capability_count>CJ_MAX_NODES)
        return 0;
    CjExecutionPlan built;
    memset(&built,0,sizeof(built));
    memset(built.producer,CJ_NONE,sizeof(built.producer));
    memset(built.last_use,CJ_NONE,sizeof(built.last_use));
    memset(built.reuse_source,CJ_NONE,sizeof(built.reuse_source));
    uint32_t available=0;
    for (uint8_t v=0;v<d->value_count;v++) {
        built.storage_slot[v]=v;
        if (v<d->input_count) {
            if (d->values[v].kind!=CJ_INPUT_VALUE) return 0;
            available|=UINT32_C(1)<<v;
        }
    }
    uint32_t done=0;
    for (uint8_t position=0;position<d->stage_count;position++) {
        int selected=-1;
        for (uint8_t i=0;i<d->stage_count;i++) {
            if (done&(UINT32_C(1)<<i)) continue;
            const CjStageDescriptor *s=&d->stages[i];
            if (s->kind>CJ_BACKEND_STAGE || !s->input_count ||
                s->input_count>CJ_MAX_INPUTS || s->output>=d->value_count ||
                s->output<d->input_count || d->values[s->output].kind==CJ_INPUT_VALUE ||
                s->capability>=d->capability_count) return 0;
            const CjBackendCapability *cap=&d->capabilities[s->capability];
            if (cap->input_count!=s->input_count) return 0;
            int ready=1;
            for (uint8_t role=0;role<s->input_count;role++) {
                uint8_t v=s->inputs[role];
                if (v>=d->value_count) return 0;
                if (!(available&(UINT32_C(1)<<v))) ready=0;
            }
            if (s->after & ~done) ready=0;
            if (ready) {selected=i;break;}
        }
        if (selected<0) return 0; /* cycle or undefined dependency */
        const CjStageDescriptor *s=&d->stages[selected];
        if (available&(UINT32_C(1)<<s->output)) return 0; /* duplicate producer */
        built.order[position]=selected;
        built.producer[s->output]=position;
        built.last_use[s->output]=position;
        for (uint8_t role=0;role<s->input_count;role++)
            built.last_use[s->inputs[role]]=position;
        available|=UINT32_C(1)<<s->output;
        done|=UINT32_C(1)<<selected;
    }
    if (!(available&(UINT32_C(1)<<d->output_value))) return 0;
    built.last_use[d->output_value]=d->stage_count; /* publication is a use */
    for (uint8_t position=0;position<d->stage_count;position++) {
        const CjStageDescriptor *s=&d->stages[built.order[position]];
        const CjBackendCapability *cap=&d->capabilities[s->capability];
        for (uint8_t role=0;role<s->input_count;role++) {
            uint8_t v=s->inputs[role];
            if ((s->reuse_candidates&(UINT32_C(1)<<v)) &&
                (cap->overlap_inputs&(1u<<role)) && v>=d->input_count &&
                built.last_use[v]==position &&
                d->values[v].storage_class==d->values[s->output].storage_class) {
                built.reuse_source[s->output]=v;
                built.storage_slot[s->output]=built.storage_slot[v];
                break;
            }
        }
    }
    /* Reverse alias chain: allocate final object at its first storage producer. */
    uint8_t v=d->output_value;
    built.output_storage[v]=1;
    while (built.reuse_source[v]!=CJ_NONE) {
        v=built.reuse_source[v];
        built.output_storage[v]=1;
    }
    for (uint8_t slot=d->input_count;slot<d->value_count;slot++) {
        uint8_t last=built.last_use[slot];
        if (last!=CJ_NONE && last<d->stage_count)
            built.release_mask[last]|=UINT32_C(1)<<slot;
    }
    built.stage_count=d->stage_count;
    built.output_value=d->output_value;
    memcpy(built.stages,d->stages,sizeof(built.stages));
    memcpy(built.capabilities,d->capabilities,sizeof(built.capabilities));
    *p=built;
    return 1;
}

typedef CjExecStatus (*CjInvokeStage)(void *, uint8_t, uint16_t);
typedef void (*CjReleaseValues)(void *, uint32_t);
typedef struct {
    CjInvokeStage generated;
    CjInvokeStage backend;
    CjReleaseValues release;
} CjExecutionBridge;

/* The bridge allocates/hands off raw buffers and checks extension errors/FPE
 * before returning OK. On MISS/ERROR it cleans all remaining objects itself.
 * Generator owns sequencing, capability invocation order and release points. */
static inline CjExecStatus
cj_execute_plan(const CjExecutionPlan *p, const CjExecutionBridge *b, void *context)
{
    for (uint8_t position=0;position<p->stage_count;position++) {
        uint8_t i=p->order[position];
        const CjStageDescriptor *s=&p->stages[i];
        CjInvokeStage invoke=s->kind==CJ_GENERATED_STAGE?b->generated:b->backend;
        CjExecStatus status=invoke(context,i,p->capabilities[s->capability].binding);
        if (status!=CJ_EXEC_OK) return status;
        b->release(context,p->release_mask[position]);
    }
    return CJ_EXEC_OK;
}
#endif
